diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1cbef59..d03ad97 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -104,8 +104,9 @@ if(MODERNGEKKO_ENABLE_DOLPHIN_RUNTIME)
     set(USE_UPNP OFF CACHE BOOL "" FORCE)
     set(ENCODE_FRAMEDUMPS OFF CACHE BOOL "" FORCE)
     set(ENABLE_LLVM OFF CACHE BOOL "" FORCE)
-    # Cubeb is Dolphin's only audio backend on macOS
-    if(APPLE OR WIN32)
+    # Cubeb is Dolphin's only audio backend on macOS. Its CoreAudio code is
+    # macOS-only, so iOS builds without it.
+    if((APPLE AND NOT IOS) OR WIN32)
         set(ENABLE_CUBEB ON CACHE BOOL "" FORCE)
     else()
         set(ENABLE_CUBEB OFF CACHE BOOL "" FORCE)
@@ -255,7 +256,10 @@ if(MODERNGEKKO_ENABLE_DOLPHIN_RUNTIME)
             vendor/dolphin/Source/Core/DolphinNoGUI/PlatformWin32.cpp)
         target_link_libraries(moderngekko PRIVATE dwmapi)
     endif()
-    if(APPLE)
+    if(IOS)
+        # The iOS app supplies its own Platform (UIKit view + CAMetalLayer)
+        target_compile_definitions(moderngekko PRIVATE MODERNGEKKO_EXTERNAL_PLATFORM=1)
+    elseif(APPLE)
         # Dolphin's windowed backend for macOS
         target_sources(moderngekko PRIVATE
             vendor/dolphin/Source/Core/DolphinNoGUI/PlatformMacos.mm)
diff --git a/src/runtime/dolphin_runtime.cpp b/src/runtime/dolphin_runtime.cpp
index f9b5405..264323a 100644
--- a/src/runtime/dolphin_runtime.cpp
+++ b/src/runtime/dolphin_runtime.cpp
@@ -19,6 +19,11 @@
 #include "Core/State.h"
 #include "Core/System.h"
 #include "DolphinNoGUI/Platform.h"
+
+#ifdef MODERNGEKKO_EXTERNAL_PLATFORM
+// Implemented by the host app (e.g. the iOS shell) to provide the window/surface.
+std::unique_ptr<Platform> MODERNGEKKO_CreateExternalPlatform();
+#endif
 #include "InputCommon/ControllerInterface/Touch/InputOverrider.h"
 #include "UICommon/UICommon.h"
 #include "VideoCommon/FrameDumper.h"
@@ -620,6 +625,9 @@ RuntimeCreateResult Runtime::Create(RuntimeConfig config) {
   else
     impl->platform = Platform::CreateWin32Platform();
 #endif
+#ifdef MODERNGEKKO_EXTERNAL_PLATFORM
+  else impl->platform = MODERNGEKKO_CreateExternalPlatform();
+#endif
 #ifdef MODERNGEKKO_HAVE_COCOA
   else impl->platform = Platform::CreateMacOSPlatform();
 #endif
