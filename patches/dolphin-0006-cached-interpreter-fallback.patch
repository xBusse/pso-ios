+// With STATICRECOMP_HEARTBEAT set, prints the emulation speed and where the CPU
+// is every two seconds of wall time (called once per timing slice, CPU thread).
+void StaticRecompHeartbeat(Core::System& system)
+{
+  static const bool enabled = std::getenv("STATICRECOMP_HEARTBEAT") != nullptr;
+  if (!enabled)
+    return;
+  using Clock = std::chrono::steady_clock;
+  static Clock::time_point last_wall{};
+  static u64 last_ticks = 0;
+  const Clock::time_point now = Clock::now();
+  const u64 ticks = system.GetCoreTiming().GetTicks();
+  if (last_wall == Clock::time_point{})
+  {
+    last_wall = now;
+    last_ticks = ticks;
+    return;
+  }
+  const double seconds = std::chrono::duration<double>(now - last_wall).count();
+  if (seconds < 2.0)
+    return;
+  const double speed = 100.0 * static_cast<double>(ticks - last_ticks) /
+                       (seconds * system.GetSystemTimers().GetTicksPerSecond());
+  const auto& ppc = system.GetPPCState();
+  std::fprintf(stderr, "[staticrecomp] speed %.0f%%  pc=%08x lr=%08x\n", speed, ppc.pc, LR(ppc));
+  last_wall = now;
+  last_ticks = ticks;
+}
