diff --git a/Source/Core/AudioCommon/AudioUnitStream.cpp b/Source/Core/AudioCommon/AudioUnitStream.cpp
new file mode 100644
index 0000000000..be6dbe5eaf
--- /dev/null
+++ b/Source/Core/AudioCommon/AudioUnitStream.cpp
@@ -0,0 +1,125 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#ifdef HAVE_AUDIOUNIT
+#include "AudioCommon/AudioUnitStream.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+
+namespace
+{
+constexpr UInt32 CHANNELS = 2;
+
+bool Check(OSStatus status, const char* what)
+{
+  if (status == noErr)
+    return true;
+  ERROR_LOG_FMT(AUDIO, "AudioUnit: {} failed ({})", what, static_cast<int>(status));
+  return false;
+}
+}  // namespace
+
+OSStatus AudioUnitStream::RenderCallback(void* ref_con, AudioUnitRenderActionFlags* /*flags*/,
+                                         const AudioTimeStamp* /*timestamp*/, UInt32 /*bus*/,
+                                         UInt32 num_frames, AudioBufferList* buffers)
+{
+  auto* const self = static_cast<AudioUnitStream*>(ref_con);
+  AudioBuffer& buffer = buffers->mBuffers[0];
+  auto* const samples = static_cast<s16*>(buffer.mData);
+  const UInt32 frames = std::min<UInt32>(num_frames, buffer.mDataByteSize / (CHANNELS * sizeof(s16)));
+
+  self->m_mixer->Mix(samples, frames);
+
+  const float gain = self->m_gain.load(std::memory_order_relaxed);
+  if (gain <= 0.0f)
+  {
+    std::memset(samples, 0, frames * CHANNELS * sizeof(s16));
+  }
+  else if (gain < 1.0f)
+  {
+    for (UInt32 i = 0; i < frames * CHANNELS; ++i)
+      samples[i] = static_cast<s16>(samples[i] * gain);
+  }
+  return noErr;
+}
+
+bool AudioUnitStream::Init()
+{
+  AudioComponentDescription desc{};
+  desc.componentType = kAudioUnitType_Output;
+  desc.componentSubType = kAudioUnitSubType_RemoteIO;
+  desc.componentManufacturer = kAudioUnitManufacturer_Apple;
+
+  AudioComponent component = AudioComponentFindNext(nullptr, &desc);
+  if (!component)
+  {
+    ERROR_LOG_FMT(AUDIO, "AudioUnit: no RemoteIO component");
+    return false;
+  }
+  if (!Check(AudioComponentInstanceNew(component, &m_unit), "AudioComponentInstanceNew"))
+  {
+    m_unit = nullptr;
+    return false;
+  }
+
+  // The mixer renders interleaved stereo s16 at its sample rate; the unit
+  // converts to the hardware's rate and format.
+  const u32 sample_rate = m_mixer->GetSampleRate();
+  AudioStreamBasicDescription format{};
+  format.mSampleRate = sample_rate;
+  format.mFormatID = kAudioFormatLinearPCM;
+  format.mFormatFlags = kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked;
+  format.mChannelsPerFrame = CHANNELS;
+  format.mBitsPerChannel = 16;
+  format.mFramesPerPacket = 1;
+  format.mBytesPerFrame = CHANNELS * sizeof(s16);
+  format.mBytesPerPacket = format.mBytesPerFrame;
+  if (!Check(AudioUnitSetProperty(m_unit, kAudioUnitProperty_StreamFormat,
+                                  kAudioUnitScope_Input, 0, &format, sizeof(format)),
+             "set stream format"))
+    return false;
+
+  AURenderCallbackStruct callback{};
+  callback.inputProc = RenderCallback;
+  callback.inputProcRefCon = this;
+  if (!Check(AudioUnitSetProperty(m_unit, kAudioUnitProperty_SetRenderCallback,
+                                  kAudioUnitScope_Input, 0, &callback, sizeof(callback)),
+             "set render callback"))
+    return false;
+
+  if (!Check(AudioUnitInitialize(m_unit), "AudioUnitInitialize"))
+    return false;
+  m_initialized = true;
+
+  INFO_LOG_FMT(AUDIO, "AudioUnit: RemoteIO output, {} Hz stereo", sample_rate);
+  return true;
+}
+
+AudioUnitStream::~AudioUnitStream()
+{
+  if (!m_unit)
+    return;
+  AudioOutputUnitStop(m_unit);
+  if (m_initialized)
+    AudioUnitUninitialize(m_unit);
+  AudioComponentInstanceDispose(m_unit);
+  m_unit = nullptr;
+}
+
+bool AudioUnitStream::SetRunning(bool running)
+{
+  if (!m_unit)
+    return false;
+  return Check(running ? AudioOutputUnitStart(m_unit) : AudioOutputUnitStop(m_unit),
+               running ? "start" : "stop");
+}
+
+void AudioUnitStream::SetVolume(int volume)
+{
+  m_gain.store(std::clamp(volume, 0, 100) / 100.0f, std::memory_order_relaxed);
+}
+#endif  // HAVE_AUDIOUNIT
diff --git a/Source/Core/AudioCommon/AudioUnitStream.h b/Source/Core/AudioCommon/AudioUnitStream.h
new file mode 100644
index 0000000000..ce1f178e03
--- /dev/null
+++ b/Source/Core/AudioCommon/AudioUnitStream.h
@@ -0,0 +1,37 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+
+#ifdef HAVE_AUDIOUNIT
+#include <AudioToolbox/AudioToolbox.h>
+#endif
+
+#include "AudioCommon/SoundStream.h"
+
+// Audio output through a RemoteIO AudioUnit, for iOS (where Cubeb's CoreAudio
+// backend isn't available). The app is expected to configure and activate the
+// AVAudioSession; this only renders the mixer into the unit's buffers.
+class AudioUnitStream final : public SoundStream
+{
+#ifdef HAVE_AUDIOUNIT
+public:
+  ~AudioUnitStream() override;
+  bool Init() override;
+  bool SetRunning(bool running) override;
+  void SetVolume(int volume) override;
+  static bool IsValid() { return true; }
+
+private:
+  static OSStatus RenderCallback(void* ref_con, AudioUnitRenderActionFlags* flags,
+                                 const AudioTimeStamp* timestamp, UInt32 bus, UInt32 num_frames,
+                                 AudioBufferList* buffers);
+
+  AudioComponentInstance m_unit = nullptr;
+  bool m_initialized = false;
+  // Linear gain, 0..1, applied in the render callback (RemoteIO has no volume parameter).
+  std::atomic<float> m_gain{1.0f};
+#endif  // HAVE_AUDIOUNIT
+};
